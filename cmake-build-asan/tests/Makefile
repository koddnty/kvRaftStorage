	cd /home/koddnty/user/projects/KVraft/KVRaftStorage/cmake-build-asan && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
